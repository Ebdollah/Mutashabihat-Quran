# Copy to .env.local and fill in. .env.local is git-ignored; this file is committed.
# Values containing # or spaces must be quoted.

# ─── Storage ──────────────────────────────────────────────────────────────────
# json = local file (no database needed; good for development)
# db   = Postgres (Neon or any Postgres). Run `npm run db:migrate` first.
STORAGE=json
JSON_STORE_PATH=data/store.json

# ─── Database (used when STORAGE=db) ──────────────────────────────────────────
# Neon dashboard → Connect. Use the POOLED string (host contains "-pooler") for the app…
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"
# …and the DIRECT (unpooled) string for migrations (drizzle-kit). Falls back to DATABASE_URL if empty.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# How the app connects:
#   neon-http — Neon serverless HTTP driver (default; best on Vercel/serverless; no interactive transactions)
#   neon-ws   — Neon WebSocket pool (long-running servers; supports transactions)
#   pg        — node-postgres, for a local/self-hosted Postgres, e.g.
#               DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mutashabihat
DB_DRIVER=neon-http
# Max connections for neon-ws / pg pools.
DB_POOL_MAX=5
# Print every SQL query to the server console.
DB_LOG_QUERIES=false

# ─── Auth (Auth.js) ───────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
# Only needed in production if not auto-detected, e.g. https://mutashabihat.example.com
# AUTH_URL=
# Set to false to stop new sign-ups (existing users can still log in).
ALLOW_SIGNUP=true
# Give each new sign-up the sample sets from data/sample-sets.json.
SAMPLE_SETS_FOR_NEW_USERS=true

# ─── Seed user (npm run db:seed) ──────────────────────────────────────────────
SEED_USER_EMAIL=you@example.com
SEED_USER_PASSWORD="change-me"
SEED_USER_NAME=
# SEED_RESET_PASSWORD=true   # reset the password of an existing seed user

# ─── Quran API ────────────────────────────────────────────────────────────────
QURAN_API_BASE=https://api.quran.com/api/v4
# How long fetched ayah text is cached (seconds). Ayah text never changes.
QURAN_CACHE_SECONDS=2592000
